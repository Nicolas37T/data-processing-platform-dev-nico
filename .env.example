# ─── Identificación del país ────────────────────────────────────────────────
# Código de 2 letras del país que despliega esta instancia (PE, BO, CL, etc.)
COUNTRY=XX

# ─── Airflow UID (solo Linux) ───────────────────────────────────────────────
# En Linux ejecuta: echo "AIRFLOW_UID=$(id -u)" y pega el resultado aquí.
# En macOS y Windows con Docker Desktop no es necesario.
AIRFLOW_UID=50000

# ─── Credenciales del usuario administrador de Airflow ──────────────────────
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ─── JWT para la API de Airflow ─────────────────────────────────────────────
# Cambia este valor en producción.
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret_change_me
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
